#!/usr/bin/env bash
set -euo pipefail

# Resolve symlinks so this works when linked into another bin directory
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
  SOURCE="$(readlink -- "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
PREFIX_DIR="$(dirname -- "$SCRIPT_DIR")"
SERVER_DIR="${PREFIX_DIR}/lib/multica-server"

# Same port resolution as the backend service in docker-compose.selfhost.yml
export PORT="${BACKEND_PORT:-${API_PORT:-${SERVER_PORT:-${PORT:-8080}}}}"

# Mirrors docker/entrypoint.sh. The binaries find migrations/ next to
# themselves, so the working directory is left alone and relative paths such
# as ./data/uploads resolve against wherever this is run from.
export MULTICA_INTERNAL_DATABASE_STARTUP_STARTED_AT_UNIX="$(date +%s)"

migrate_pid=""

stop_migration() {
  signal="$1"
  exit_code="$2"
  trap - TERM INT
  if [ -n "$migrate_pid" ]; then
    kill "-$signal" "$migrate_pid" 2>/dev/null || true
    wait "$migrate_pid" 2>/dev/null || true
  fi
  exit "$exit_code"
}

trap 'stop_migration TERM 143' TERM
trap 'stop_migration INT 130' INT

echo "Running database migrations..."
"${SERVER_DIR}/migrate" up &
migrate_pid=$!
if wait "$migrate_pid"; then
  migrate_status=0
else
  migrate_status=$?
fi
migrate_pid=""
trap - TERM INT
if [ "$migrate_status" -ne 0 ]; then
  exit "$migrate_status"
fi

echo "Starting server..."
exec "${SERVER_DIR}/server" "$@"
